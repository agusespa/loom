#!/bin/sh

echo "> Running pre-push hook..."

set -e

./scripts/verify.sh

if [ -f playwright.config.js ] || [ -f playwright.config.ts ]; then
    npx playwright install chromium webkit
    npm run test:e2e
else
    echo ">> No Playwright config yet, skipping e2e"
fi

echo "✓ All checks passed!"
exit 0
